# AccelByte Gaming Services (AGS) settings for online play.
# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.
# Everything here is bundled into the browser build, so it must only ever hold
# public values. Never put a client secret in this file.

# Online backend: "mock" (default) plays between tabs of one browser with no
# server; "ags" uses AccelByte Gaming Services with the settings below.
VITE_BACKEND_MODE=mock

# Base URL of your AGS environment, e.g. https://<studio>-<game>.prod.gamingservices.accelbyte.io
VITE_AGS_BASE_URL=https://your-namespace.prod.gamingservices.accelbyte.io
# Game namespace
VITE_AGS_NAMESPACE=your-game-namespace
# Public IAM client ID (Device login enabled, no secret)
VITE_AGS_CLIENT_ID=your-public-client-id
# Session V2 template used for rooms (server type NONE, max 2 players)
VITE_AGS_SESSION_TEMPLATE=letteroff-room
# Match pool used for Quick match (1v1)
VITE_AGS_MATCH_POOL=letteroff-quick
